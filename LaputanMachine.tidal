--FROM here
--
--
-- This is nice

d1 $ iter 4
  $ sometimes (# speed 1.6)
  $ sometimes (# legato 2)
  $ sometimesBy 0.2 (fast 2)
  $ every 3 (# octer 1)
  $ sometimes (#octave 3)
  $ slowcat [
    n (toScale [0,2,3,7,10] "0 0 [2 3] 0"),
    n (toScale [0,2,3,7,10] "[0 3] 2 0 [1 0]"),
    n (toScale [0,2,3,7,10] "0 [2 0] 3 2"),
    n (toScale [0,2,3,7,10] "0 1 [0 2] [3 0]")
  ] # s "amencutup"
  # legato 1
  # speed 0.8
  # distort 0.1
  # shape 0.7

d1 $ silence

d2 $ stack [
fast 2 $ n (toScale [0,2,3,7,10] "<0 2 0 [0 3]> <1 0> <2 [2 3] 0>") #s "bass" #speed 0.8 #lpf 900  #resonance (range 0.5 0.9 rand) #nudge "0 0.02 0 0.0015",
fast 2 $ n (toScale [0,2,3,10] "<0 3 [2 0]> <0 2>") #s "industrial" #speed 0.9 #nudge "0 0.3"
]

d2 $ silence

d3 $ fast 2 $ n (toScale [0,2,3,7,10] "<0 2 0 [0 3]> <1 0> <2 [2 3] 0>") #s "bass3" #speed 0.8 #lpf 100 #nudge "0 0.02 0 0.0015"

d3 $ silence

d4 $ whenmod 9 7 (striate 13) $ stack [
sound "dist dist*3" #ring 0.8 #ringf 30 #attack 0.2 #sustain 0.2 #legato 1,
sound "feel" +| "0 .. 15",
sound "industrial*8" #speed 0.5 #gain 0.7
]# speed "[[1 0.8], [1.5 2]*2]/3"

d5 $ slow 2 $ n (toScale [0,2,3,7,10] (euclid 5 8 "0 3 1")) #s "insect" #speed 0.89

d6 $ fast 2 $ n (toScale [0,1,6,7,8,13,14] (slowcat [
"<0 1> 2 <3 [3 4]> 1",
"0 [1 6] 2 <0 3>",
"[0 1] 2 3 [2 0]"
]))
#s "supersaw"
#legato 0.6
#distort 1.2
#ringf 50
#ring 0.7
#lpf 1500
#room 0.7
#gain 0.7

d6 $ silence

d7 $ stack [
n (toScale [0,1,6,7,8] "0 ~ 2 ~"),
n (toScale [0,1,6,7,8] "0 ~ 2 ~") # detune 0.3,
n (toScale [0,1,6,7,8] "0 ~ 2 ~") # detune (-0.5)
]
#s "supersaw"
#legato 2
#distort 1.2
#ringf 80
#ring 0.9
#lpf 300
#resonance 0.2
#room 0.6
#gain 0.5


d8 $ jux rev $ every 4 (striate 8) $ every 3 (chop 16) $
n (toScale [0,1,6,7,8] (slowcat [
"0",
"[0 6]",
"[0 6 8]",
"6"
]))
#s "supersaw"
#legato 4
#krush 0.8
#ringf (range 10 30 rand)
#ring (range 0.4 0.8 rand)
#detune (slow 7 $ range (-0.8) 0.8 sine)
#lpf (range 300 1200 $ slow 5 sine)
#resonance (range 0.4 0.6 rand)
#room 0.9
#size 0.95
#gain 0.55

d10 $ jux (#detune 0.93) $ n (toScale [0,1,6,7,8] "0 1 6 3"
+ (segment 16 $ range (-0.3) 0.3 rand))
#s "supersaw"
#krush 0.8
#octave 3
#octer 1
#ringf 40
#ring 0.2
#legato 0.8
#gain 0.9
#room 0.2
#size 0.7

d10 $ silence


